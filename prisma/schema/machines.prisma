// Módulo 7 · Control de equipo y máquinas.

enum MachineStatus {
  OPERATIONAL
  MAINTENANCE
  OUT_OF_SERVICE
}

model Machine {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique
  name      String
  area      String
  status    MachineStatus @default(OPERATIONAL)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  statusChanges MachineStatusChange[]

  @@index([area, status])
  @@map("machines")
}

model MachineStatusChange {
  id          String        @id @default(uuid()) @db.Uuid
  machineId   String        @map("machine_id") @db.Uuid
  machine     Machine       @relation(fields: [machineId], references: [id])
  fromStatus  MachineStatus @map("from_status")
  toStatus    MachineStatus @map("to_status")
  reason      String
  changedById String        @map("changed_by_id") @db.Uuid
  changedBy   User          @relation(fields: [changedById], references: [id])
  changedAt   DateTime      @default(now()) @map("changed_at")

  @@index([machineId, changedAt])
  @@map("machine_status_changes")
}
