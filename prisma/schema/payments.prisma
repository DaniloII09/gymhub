// Módulo 5 · Pagos y comprobantes.

enum ChargeType {
  MEMBERSHIP
  PERSONAL_SESSION
}

enum ChargeStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
}

enum PaymentStatus {
  APPROVED
  REJECTED
}

// "Concepto de pago". Lo crean M1 (membresía) y M3 (sesión personal) vía
// PaymentsService; la FK vive del lado de Membership / PersonalSession.
model Charge {
  id          String       @id @default(uuid()) @db.Uuid
  memberId    String       @map("member_id") @db.Uuid
  member      User         @relation(fields: [memberId], references: [id])
  type        ChargeType
  description String
  amount      Decimal      @db.Decimal(10, 2)
  status      ChargeStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") // base de "días de atraso"
  paidAt      DateTime?    @map("paid_at")

  membership      Membership?
  personalSession PersonalSession?
  payments        Payment[]

  @@index([memberId, status])
  @@index([status, createdAt])
  @@map("charges")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  chargeId        String        @map("charge_id") @db.Uuid
  charge          Charge        @relation(fields: [chargeId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus
  rejectionReason String?       @map("rejection_reason") // H19
  gatewayRef      String?       @unique @map("gateway_ref") // id de la pasarela
  recordedById    String?       @map("recorded_by_id") @db.Uuid // null si fue en línea
  recordedBy      User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  receipt Receipt?

  @@index([chargeId])
  @@map("payments")
}

// Inmutable: guarda copia de los datos (snapshot) para que no cambie si luego
// se edita el nombre del miembro o el plan. Solo se puede anular.
model Receipt {
  id          String        @id @default(uuid()) @db.Uuid
  number      Int           @unique @default(autoincrement()) // correlativo (secuencia)
  paymentId   String        @unique @map("payment_id") @db.Uuid
  payment     Payment       @relation(fields: [paymentId], references: [id])
  memberName  String        @map("member_name")
  chargeType  ChargeType    @map("charge_type")
  description String
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  issuedAt    DateTime      @default(now()) @map("issued_at")
  voidedAt    DateTime?     @map("voided_at")
  voidReason  String?       @map("void_reason")
  voidedById  String?       @map("voided_by_id") @db.Uuid
  voidedBy    User?         @relation("ReceiptVoidedBy", fields: [voidedById], references: [id])

  @@index([issuedAt])
  @@map("receipts")
}
