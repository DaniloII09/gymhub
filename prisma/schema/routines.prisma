// Épica 6 · Rutinas y progreso. Dueño: Christian (DB-18.1, DB-19.1).
// Agregá acá los modelos de tu módulo en tu feat branch. Si referencian a
// User, agregá la relación opuesta en users.prisma (revisión de Danilo).
// IDs: Int autoincrement para el dominio; los usuarios usan UUID.

/// Rutina de entrenamiento creada por un entrenador para un miembro (H18).
/// Restricciones agregadas a mano en la migración DB-18.1:
///   - CHECK longitud de name (trim) entre 3 y 60.
///   - CHECK days_of_week contiene entre 1 y 7 días válidos (1..7).
model Routine {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(60)
  trainerId  String   @map("trainer_id") @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  daysOfWeek Int[]    @map("days_of_week")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  trainer   User              @relation("TrainerRoutines", fields: [trainerId], references: [id], onDelete: Restrict)
  member    User              @relation("MemberRoutines", fields: [memberId], references: [id], onDelete: Restrict)
  exercises RoutineExercise[]

  @@index([trainerId])
  @@index([memberId])
  @@map("routines")
}

/// Ejercicio perteneciente a una rutina (H18). Se elimina en cascada con la rutina.
/// Restricciones agregadas a mano en la migración DB-18.1:
///   - CHECK sets BETWEEN 1 AND 10.
///   - CHECK reps BETWEEN 1 AND 50.
///   - CHECK suggested_weight_kg BETWEEN 0 AND 300.
model RoutineExercise {
  id                Int      @id @default(autoincrement())
  routineId         Int      @map("routine_id")
  sortOrder         Int      @map("sort_order")
  name              String   @db.VarChar(80)
  sets              Int
  reps              Int
  suggestedWeightKg Decimal  @default(0) @map("suggested_weight_kg") @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId, sortOrder])
  @@map("routine_exercises")
}
