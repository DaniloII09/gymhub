// Módulo 2 · Clases grupales.

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED_BY_MEMBER
  CANCELLED_BY_GYM
}

enum AttendanceStatus {
  ATTENDED
  NO_SHOW
}

model GroupClass {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  trainerId       String   @map("trainer_id") @db.Uuid
  trainer         User     @relation(fields: [trainerId], references: [id])
  room            String
  weekday         Weekday
  startMinute     Int      @map("start_minute") // minutos desde 00:00 (ej. 18:30 = 1110)
  durationMinutes Int      @map("duration_minutes")
  capacity        Int // 1..50, validado en DTO
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sessions ClassSession[]
  reviews  Review[]

  @@index([room, weekday])
  @@index([trainerId, weekday])
  @@map("group_classes")
}

model ClassSession {
  id            String        @id @default(uuid()) @db.Uuid
  groupClassId  String        @map("group_class_id") @db.Uuid
  groupClass    GroupClass    @relation(fields: [groupClassId], references: [id])
  startsAt      DateTime      @map("starts_at")
  endsAt        DateTime      @map("ends_at")
  capacity      Int // copia del cupo de la clase al generar la sesión
  // Contador para el control de cupo atómico:
  // UPDATE ... SET reserved_count = reserved_count + 1 WHERE reserved_count < capacity
  reservedCount Int           @default(0) @map("reserved_count")
  status        SessionStatus @default(SCHEDULED)
  cancelReason  String?       @map("cancel_reason")
  cancelledAt   DateTime?     @map("cancelled_at")

  reservations ClassReservation[]

  @@unique([groupClassId, startsAt])
  @@index([startsAt])
  @@map("class_sessions")
}

model ClassReservation {
  id                   String            @id @default(uuid()) @db.Uuid
  sessionId            String            @map("session_id") @db.Uuid
  session              ClassSession      @relation(fields: [sessionId], references: [id])
  memberId             String            @map("member_id") @db.Uuid
  member               User              @relation(fields: [memberId], references: [id])
  status               ReservationStatus @default(CONFIRMED)
  // Membresía a la que se le descontó la clase (para devolverla al cancelar).
  consumedMembershipId String?           @map("consumed_membership_id") @db.Uuid
  consumedMembership   Membership?       @relation(fields: [consumedMembershipId], references: [id])
  attendance           AttendanceStatus?
  attendanceMarkedAt   DateTime?         @map("attendance_marked_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  cancelledAt          DateTime?         @map("cancelled_at")

  review Review?

  // Una fila por miembro y sesión: si cancela y vuelve a reservar, se reactiva.
  @@unique([sessionId, memberId])
  @@index([memberId])
  @@map("class_reservations")
}
