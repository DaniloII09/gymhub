// Épica 2 · Clases grupales. Dueño: Luis (DB-6.1, DB-7.1).
// Programación y edición de clases grupales (H06) y calendario/reservas (H07).
// IDs: Int autoincrement para el dominio; los usuarios usan UUID.

enum ClassStatus {
  SCHEDULED
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

/// Clase grupal programada por el administrador (H06).
/// El cupo debe estar entre 1 y 50, y endsAt debe ser mayor que startsAt
/// (restricciones CHECK en la migración DB-6.1).
model GymClass {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(60)
  trainerId String      @map("trainer_id") @db.Uuid
  startsAt  DateTime    @map("starts_at")
  endsAt    DateTime    @map("ends_at")
  capacity  Int
  status    ClassStatus @default(SCHEDULED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trainer      User               @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  reservations ClassReservation[]

  @@index([trainerId, startsAt])
  @@index([startsAt])
  @@map("gym_classes")
}

/// Reserva de un miembro en una clase grupal (DB-7.1 / H06-H07).
model ClassReservation {
  id        Int               @id @default(autoincrement())
  classId   Int               @map("class_id")
  memberId  String            @map("member_id") @db.Uuid
  status    ReservationStatus @default(CONFIRMED)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  gymClass GymClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  member   User     @relation("MemberClassReservations", fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([classId, memberId])
  @@index([classId, status])
  @@index([memberId, status])
  @@map("class_reservations")
}

