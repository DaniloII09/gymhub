// Módulo 0 · Usuarios y autenticación. Base del boilerplate + rol.
// Dueño del archivo: lo revisa Danilo. Solo se agrega lo imprescindible para
// el control de acceso (el campo `role`). Los datos de perfil del miembro
// (nombre, sexo, fecha de nacimiento, código, etc.) los agrega H01 en su rama.

enum Role {
  MEMBER
  TRAINER
  RECEPTION
  ADMIN
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String  @map("password_hash")
  role         Role    @default(MEMBER)
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  // NOTA PARA EL EQUIPO: cuando tu modelo referencie a User (ej. Membership.member,
  // GroupClass.trainer), agregá acá la relación opuesta. Este archivo tiene
  // CODEOWNER = Danilo, así que ese cambio pasa por su revisión.

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
