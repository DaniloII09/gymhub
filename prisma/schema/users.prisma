// Módulo 0 · Usuarios y autenticación. Base del boilerplate + rol + perfil (H01).
// Dueño del archivo: lo revisa Danilo (CODEOWNER). Acá viven el control de acceso
// (campo `role`) y los datos de perfil que guarda la inscripción de miembros
// (H01/DB-1.1): fullName, sex, birthDate, enrolledAt y memberCode.

enum Role {
  MEMBER
  TRAINER
  RECEPTION
  ADMIN
}

enum Sex { 
  M 
  F 
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  fullName  String    @db.VarChar(100)
  sex       Sex?
  birthDate DateTime? @db.Date
  email     String    @unique

  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false)
  role               Role      @default(MEMBER)
  isActive           Boolean   @default(true) @map("is_active")
  enrolledAt         DateTime? @db.Date
  memberCode         String?   @unique @db.VarChar(10)

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  // NOTA PARA EL EQUIPO: cuando tu modelo referencie a User (ej. Membership.member,
  // GroupClass.trainer), agregá acá la relación opuesta. Este archivo tiene
  // CODEOWNER = Danilo, así que ese cambio pasa por su revisión.

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}