// Épica 1 · Membresías y planes. Dueño: Danilo (DB-3.1, DB-4.1).
// Agregá acá los modelos de tu módulo en tu feat branch. Si referencian a
// User, agregá la relación opuesta en users.prisma (revisión de Danilo).
// IDs: Int autoincrement para el dominio; los usuarios usan UUID.

enum PlanType {
  MONTHLY
  QUARTERLY
  DROP_IN
}

/// Plan que vende el gimnasio (H03). Restricciones que Prisma no representa y
/// que van a mano en la migración DB-3.1:
///   - CHECK price > 0.
///   - CHECK durationDays entre 1 y 365, salvo DROP_IN, que va sin duración.
///   - Índice único sobre lower(name): el nombre no se repite aunque cambien
///     las mayúsculas.
///   - Índice único parcial: un solo plan DROP_IN activo a la vez.
/// Borrado lógico con isActive: desactivar no toca las membresías vendidas.
model Plan {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(40)
  type         PlanType
  /// Vacío en DROP_IN: la clase suelta vence el mismo día.
  durationDays Int?     @map("duration_days")
  price        Decimal  @db.Decimal(8, 2)
  benefits     String?  @db.VarChar(300)
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@index([isActive])
  @@map("plans")
}

/// Valor guardado de la membresía (DB-4.1). El estado que ven las pantallas lo
/// calcula MembershipStatusService (BE-4.3) a partir del cobro y las fechas;
/// la tarea diaria de las 00:05 sincroniza este valor y statusChangedAt.
enum MembershipStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

/// Compra o renovación de una membresía (H04). Cada compra es un registro
/// nuevo: el historial es permanente y no se borra.
///
/// endDate = startDate + durationDays − 1 (último día con acceso). Para la
/// clase suelta, startDate y endDate son el mismo día. CHECK en la migración:
/// end_date >= start_date.
///
/// El cobro apunta a la membresía (charges.membership_id, de Pagos), así que
/// la membresía no depende de la tabla de cobros para existir.
model Membership {
  id              Int              @id @default(autoincrement())
  memberId        String           @map("member_id") @db.Uuid
  planId          Int              @map("plan_id")
  /// Copia del tipo del plan al vender: el plan puede editarse después.
  planType        PlanType         @map("plan_type")
  startDate       DateTime         @map("start_date") @db.Date
  endDate         DateTime         @map("end_date") @db.Date
  status          MembershipStatus @default(PENDING_PAYMENT)
  /// true si el miembro ya tuvo antes una membresía MONTHLY o QUARTERLY.
  isRenewal       Boolean          @default(false) @map("is_renewal")
  statusChangedAt DateTime         @default(now()) @map("status_changed_at")
  /// Recepción o administrador que la vendió.
  createdById     String           @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member    User     @relation("MemberMemberships", fields: [memberId], references: [id], onDelete: Restrict)
  createdBy User     @relation("MembershipsSold", fields: [createdById], references: [id], onDelete: Restrict)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  charge    Charge?

  @@index([memberId, endDate])
  @@index([status, endDate])
  @@map("memberships")
}
