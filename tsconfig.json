{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    // Alias por módulo. Cada entrada apunta al barrel (index.ts) de la carpeta.
    // Reglas: rutas con `./`, el comodín termina en `/index.ts`, y cada módulo
    // necesita además su entrada sin comodín.
    "paths": {
      "@Auth": ["./src/auth/index.ts"],
      "@Auth/*": ["./src/auth/*/index.ts"],
      "@Users": ["./src/users/index.ts"],
      "@Users/*": ["./src/users/*/index.ts"],
      "@Health": ["./src/health/index.ts"],
      "@Health/*": ["./src/health/*/index.ts"],
      "@Prisma": ["./src/prisma/index.ts"],
      "@Prisma/*": ["./src/prisma/*/index.ts"],
      "@Common/*": ["./src/common/*/index.ts"],
      "@Config": ["./src/config/index.ts"],
      "@PrismaClient": ["./src/generated/prisma/client.ts"],

      "@Memberships": ["./src/memberships/index.ts"],
      "@Memberships/*": ["./src/memberships/*/index.ts"],
      "@CheckIns": ["./src/check-ins/index.ts"],
      "@CheckIns/*": ["./src/check-ins/*/index.ts"],
      "@Classes": ["./src/classes/index.ts"],
      "@Classes/*": ["./src/classes/*/index.ts"],
      "@Trainers": ["./src/trainers/index.ts"],
      "@Trainers/*": ["./src/trainers/*/index.ts"],
      "@Payments": ["./src/payments/index.ts"],
      "@Payments/*": ["./src/payments/*/index.ts"],
      "@Routines": ["./src/routines/index.ts"],
      "@Routines/*": ["./src/routines/*/index.ts"],
      "@Machines": ["./src/machines/index.ts"],
      "@Machines/*": ["./src/machines/*/index.ts"],
      "@Reviews": ["./src/reviews/index.ts"],
      "@Reviews/*": ["./src/reviews/*/index.ts"],
      "@Notifications": ["./src/notifications/index.ts"],
      "@Notifications/*": ["./src/notifications/*/index.ts"],
      "@Reports": ["./src/reports/index.ts"],
      "@Reports/*": ["./src/reports/*/index.ts"]
    }
  }
}
