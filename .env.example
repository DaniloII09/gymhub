# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL (consumido por docker-compose para inicializar el contenedor)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gymhub
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Prisma
# Al correr la API en el host contra el Postgres de Docker, el host es localhost.
# Al correr la API dentro de docker-compose, docker-compose.yml sobreescribe
# esta variable para apuntar al servicio `postgres` en lugar de `localhost`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymhub?schema=public

# ---------------------------------------------------------------------------
# Autenticación
# Generá un secreto propio: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# CORS: orígenes permitidos, separados por coma (URL del frontend, sin "/" final).
# Si se omite, se permite http://localhost:3001.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Seed (prisma/seed.ts). Contraseñas de las cuentas de prueba.
# En local se pueden dejar vacías (se usa la contraseña demo de las pruebas e2e).
# En producción SIEMPRE se definen, y nunca se suben al repositorio.
# ---------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_MEMBER_PASSWORD=

# ---------------------------------------------------------------------------
# Sesiones personales (DB-11.1 / H11). Precio de la sesión personal.
# SEED_PERSONAL_SESSION_PRICE lo usa el seed para guardarlo en la base (15 según
# las historias). PERSONAL_SESSION_PRICE es opcional en la API si no está en la base.
# ---------------------------------------------------------------------------
SEED_PERSONAL_SESSION_PRICE=15
# PERSONAL_SESSION_PRICE=